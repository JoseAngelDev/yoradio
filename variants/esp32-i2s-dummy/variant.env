# Per-variant build settings (all optional; defaults shown)
CHIP=esp32                # esp32 | esp32s3  -> selects board and flash offsets
PARTITION=min_spiffs      # arduino-esp32 PartitionScheme (min_spiffs, default, huge_app, ...)
CORE_VERSION=2.0.17       # arduino-esp32 core; 3.x aborts at boot (legacy I2S + new ADC driver)
